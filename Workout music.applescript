set AppleScript's text item delimiters to ","
set pids to text items of idText
set AppleScript's text item delimiters to ""
set added to 0
set missing to 0
tell application "Music"
	with timeout of 3600 seconds
		if exists user playlist plName then
			set pl to user playlist plName
			delete every track of pl
		else
			set pl to make new user playlist with properties {name:plName}
		end if
		repeat with pid in pids
			try
				duplicate (first track of library playlist 1 whose persistent ID is (contents of pid)) to pl
				set added to added + 1
			on error
				set missing to missing + 1
			end try
		end repeat
	end timeout
	set msg to "Added " & added & " songs to \"" & plName & "\"."
	if missing > 0 then set msg to msg & return & missing & " songs weren't found in your library."
	display dialog msg buttons {"OK"} default button 1
end tell
